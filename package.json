{
  "name": "laramac",
  "productName": "Laramac",
  "version": "0.11.0",
  "description": "A free, open-source local development environment for macOS, inspired by Laragon.",
  "main": "./out/main/index.js",
  "author": "Laramac contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --mac --publish never",
    "dist:dir": "electron-vite build && electron-builder --mac --dir --publish never",
    "test": "vitest run"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.6",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "basic-ftp": "^6.2.4",
    "lucide-react": "^1.66.0",
    "ssh2": "^1.17.0",
    "tar": "^7.5.22",
    "undici": "^8.12.3",
    "yauzl": "^3.4.0"
  }
}
